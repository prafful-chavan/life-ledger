#!/bin/sh
# Runs before every `git push`: a changed script must carry a new version number, and every unit test must pass.
# (CI runs the full browser suite as well, and only deploys the site if everything passes.)
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: checking script versions and unit tests…"
node tests/version-lock.test.js >/dev/null 2>&1 || { node tests/version-lock.test.js 2>&1 | grep -E "CHANGED|stale|not in|does not" | head -5; echo "pre-push: blocked (see above)."; exit 1; }
node tools/run-unit-tests.js || { echo "pre-push: blocked — fix the failing tests, or push with --no-verify if you are sure."; exit 1; }
